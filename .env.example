# ── Brey Fitness — variables de entorno ─────────────────────────────────────
# Copia este archivo a .env.local y completa los valores. Ver LANZAMIENTO.md.

# Dominio público del sitio (sin barra final). Lo usan sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Email de soporte que se muestra en las páginas legales.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@tudominio.com

# Brevo (email marketing) — crea una API key en app.brevo.com → SMTP & API.
# Sin esta clave, los formularios de email responden "disponible pronto".
BREVO_API_KEY=
# Opcional: ID numérico de la lista de Brevo donde guardar los contactos.
BREVO_LIST_ID=

# Opcional: analítica con Plausible. Pon tu dominio (ej. tudominio.com)
# para activar el script; déjalo vacío para no cargar analítica.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Supabase (auth + base de datos) — crea el proyecto en supabase.com,
# copia estos dos valores desde Project Settings → API. La anon key es
# pública a propósito (va en el JS del navegador) — la protección real
# de los datos la da Row Level Security (ver supabase/schema.sql), no
# mantener esta clave en secreto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo si en el futuro se necesita una ruta de servidor con privilegios
# de admin (no usada en esta iteración: la creación de perfiles va por
# un trigger de Postgres, no por esta clave). Si algún día se usa:
# NUNCA con prefijo NEXT_PUBLIC_, nunca en código alcanzable por el cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# ── BREY IA (opcional) ──────────────────────────────────────────────────────
# La única parte del sistema que usa un modelo de lenguaje. Sin ninguna de
# estas claves el informe funciona COMPLETO: es determinista y no usa modelo.
# Lo único que falta es el campo de preguntas al final del informe.
#
# NINGUNA lleva prefijo NEXT_PUBLIC_, y no es un descuido: ese prefijo hace que
# Next incruste el valor en el JavaScript que llega al navegador. Una clave de
# API ahí queda publicada para cualquiera que abra las herramientas del
# navegador. Se leen solo desde la acción de servidor (src/lib/bcs/ia/).

# Google Gemini — capa gratuita. Crea la clave en aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — de pago por uso. Crea la clave en console.anthropic.com
ANTHROPIC_API_KEY=

# Cuál de los dos usar. Si se deja vacío se elige por la clave que exista, y
# con las dos puestas gana Gemini (es la gratuita: evita una factura sorpresa).
# Valores: gemini | anthropic
BREY_IA_PROVEEDOR=

# Modelo concreto, opcional. Vacío = el de por defecto del proveedor elegido
# (gemini-3.5-flash-lite / claude-opus-5). Sirve para cambiar de modelo sin
# tocar código: por ejemplo claude-sonnet-5, que para esta tarea basta y cuesta
# bastante menos que Opus.
#
# OJO con la capa gratuita de Gemini: son 20 peticiones AL DÍA por modelo en
# las variantes grandes (gemini-3.7-flash y similares). Las variantes `lite`
# tienen cuota aparte y bastante más holgada, y por eso el valor por defecto
# es una de ellas. Cuotas: ai.dev/rate-limit
BREY_IA_MODELO=
